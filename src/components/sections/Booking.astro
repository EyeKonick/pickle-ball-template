---
/**
 * Book a Court: the stepped reservation form.
 * Steps: court & time → details → review → GCash payment → proof → Pending Review.
 * Behaviour lives in src/scripts/booking.ts; all content comes from src/data.
 */
import { Image } from 'astro:assets';
import { site, bookingEndpointReady } from '../../data/site-config';
import steps from '../../data/booking-steps.json';
import { courts, groupName, startHours } from '../../utils/slots';
import { formatHour, toTimeValue } from '../../utils/format';
import qrSample from '../../assets/images/payment/gcash-qr-sample.svg';
import BookingStep from '../ui/BookingStep.astro';
import Button from '../ui/Button.astro';
import CourtMap from '../ui/CourtMap.astro';
import CourtSummary from '../ui/CourtSummary.astro';
import TimeScrubber from '../ui/TimeScrubber.astro';
import SectionHeading from '../ui/SectionHeading.astro';

const copy = site.sections.booking;
const players = Array.from({ length: site.booking.maxPlayers }, (_, i) => i + 1);
const durations = Array.from({ length: site.booking.maxDurationHours }, (_, i) => i + 1);
---

<section class="booking" id="booking" aria-labelledby="booking-title">
  <div class="container">
    <SectionHeading id="booking-title" lines={copy.lines}>{copy.lede}</SectionHeading>

    <div class="booking__layout" data-booking data-step="slot" data-demo={bookingEndpointReady ? undefined : ''} data-reveal>
      <ol class="progress" aria-label="Booking progress">
        {
          steps.formSteps.map((s, i) => (
            <li data-progress={s.id} aria-current={i === 0 ? 'step' : undefined}>
              <span class="progress__dot tabular" aria-hidden="true">
                {i + 1}
              </span>
              <span class="progress__label">{s.label}</span>
            </li>
          ))
        }
      </ol>

      <form class="booking__form" novalidate data-booking-form aria-labelledby="booking-title">
        <BookingStep id="slot" number={1} title="Choose your court and time">
          <div class="controls">
            <div class="field">
              <label for="bk-date">Date</label>
              <input id="bk-date" name="date" type="date" required aria-describedby="bk-date-error" />
              <p class="field__error" id="bk-date-error" aria-live="polite"></p>
            </div>
            <div class="field">
              <label for="bk-start">Start time</label>
              <select id="bk-start" name="start" required>
                {startHours.map((h) => <option value={toTimeValue(h)} selected={h === 19}>{formatHour(h)}</option>)}
              </select>
            </div>
            <fieldset class="group">
              <legend>Duration</legend>
              <div class="tiles tiles--duration">
                {
                  durations.map((h) => (
                    <label class="tile tile--compact">
                      <input type="radio" name="hours" value={h} checked={h === 1} />
                      <span class="tile__main">
                        {h} {h === 1 ? 'hour' : 'hours'}
                      </span>
                    </label>
                  ))
                }
              </div>
            </fieldset>
          </div>

          <TimeScrubber />
          <CourtMap />
          <CourtSummary />

          <fieldset class="group" aria-describedby="bk-court-help bk-court-error">
            <legend>Court</legend>
            <p class="help" id="bk-court-help">Pick on the map or here. Struck-out courts are not open for your whole time.</p>
            <div class="tiles tiles--courts">
              {
                courts.map((court) => (
                  <label class="tile">
                    <input type="radio" name="court" value={court.id} />
                    <span class="tile__main">{court.name}</span>
                    <span class="tile__sub" data-tile-status={court.id}>
                      {groupName(court.group)}
                    </span>
                  </label>
                ))
              }
            </div>
            <p class="field__error" id="bk-court-error" aria-live="polite"></p>
          </fieldset>

          <Fragment slot="actions">
            <span></span>
            <Button data-next>Continue to your details</Button>
          </Fragment>
        </BookingStep>

        <BookingStep id="details" number={2} title="Your details">
          <div class="field">
            <label for="bk-name">Full name</label>
            <input id="bk-name" name="name" type="text" autocomplete="name" required aria-describedby="bk-name-error" />
            <p class="field__error" id="bk-name-error" aria-live="polite"></p>
          </div>
          <div class="row">
            <div class="field">
              <label for="bk-mobile">Mobile number</label>
              <input
                id="bk-mobile"
                name="mobile"
                type="tel"
                inputmode="tel"
                autocomplete="tel"
                placeholder="0917 555 0142"
                required
                aria-describedby="bk-mobile-help bk-mobile-error"
              />
              <p class="help" id="bk-mobile-help">We text you when staff approve or reject your request.</p>
              <p class="field__error" id="bk-mobile-error" aria-live="polite"></p>
            </div>
            <div class="field">
              <label for="bk-email">Email</label>
              <input id="bk-email" name="email" type="email" autocomplete="email" required aria-describedby="bk-email-error" />
              <p class="field__error" id="bk-email-error" aria-live="polite"></p>
            </div>
          </div>
          <div class="field field--narrow">
            <label for="bk-players">Number of players</label>
            <select id="bk-players" name="players">
              {players.map((n) => <option value={n} selected={n === 4}>{n}</option>)}
            </select>
          </div>
          <div class="field">
            <label for="bk-notes">Notes <span class="optional">(optional)</span></label>
            <textarea id="bk-notes" name="notes" rows="3" maxlength="500"></textarea>
          </div>

          <Fragment slot="actions">
            <Button variant="ghost" arrow={false} data-back>Back</Button>
            <Button data-next>Next: review</Button>
          </Fragment>
        </BookingStep>

        <BookingStep id="review" number={3} title="Review your request">
          <dl class="review" data-review></dl>
          <div class="policy">
            <h4>Cancellation and reschedule policy</h4>
            <p>{site.policy.cancellation}</p>
            <p>{site.policy.confirmation}</p>
          </div>
          <div class="field">
            <label class="check">
              <input type="checkbox" name="agree" required aria-describedby="bk-agree-error" />
              <span>I agree to the cancellation and reschedule policy, and I understand my slot is not confirmed until staff verify my payment.</span>
            </label>
            <p class="field__error" id="bk-agree-error" aria-live="polite"></p>
          </div>

          <Fragment slot="actions">
            <Button variant="ghost" arrow={false} data-back>Back</Button>
            <Button data-next>Next: pay via GCash</Button>
          </Fragment>
        </BookingStep>

        <BookingStep id="payment" number={4} title="Pay via GCash">
          <div class="pay">
            <figure class="pay__qr">
              <Image src={qrSample} alt="SAMPLE QR: replace with the club's GCash QR" width={240} height={240} />
            </figure>
            <div class="pay__details">
              <p class="pay__label">Send exactly</p>
              <p class="pay__amount display tabular" data-amount></p>
              <dl class="pay__account">
                <div>
                  <dt>Account name</dt>
                  <dd>{site.gcash.accountName}</dd>
                </div>
                <div>
                  <dt>GCash number</dt>
                  <dd class="tabular">{site.gcash.accountNumber}</dd>
                </div>
              </dl>
              <p class="help">
                Scan the QR code in the GCash app, or send to the number above. Keep the receipt screen open: you need a screenshot and the reference number next.
              </p>
            </div>
          </div>

          <Fragment slot="actions">
            <Button variant="ghost" arrow={false} data-back>Back</Button>
            <Button data-next>I've paid: add proof</Button>
          </Fragment>
        </BookingStep>

        <BookingStep id="proof" number={5} title="Proof of payment">
          <div class="field">
            <span class="label" id="bk-shot-label">Screenshot of your GCash receipt</span>
            <label class="upload" for="bk-shot">
              <input
                id="bk-shot"
                name="screenshot"
                type="file"
                accept="image/*"
                required
                aria-labelledby="bk-shot-label"
                aria-describedby="bk-shot-help bk-shot-error"
              />
              <span class="upload__prompt" data-upload-prompt>
                <strong>Choose an image</strong>
                <span>JPG, PNG or WebP, up to {site.booking.maxUploadMB} MB</span>
              </span>
              <span class="upload__preview" data-upload-preview hidden></span>
            </label>
            <p class="help" id="bk-shot-help">The screenshot must show the amount, the date and the reference number.</p>
            <p class="field__error" id="bk-shot-error" aria-live="polite"></p>
          </div>
          <div class="field field--narrow">
            <label for="bk-ref">GCash reference number</label>
            <input
              id="bk-ref"
              name="gcashRef"
              type="text"
              inputmode="numeric"
              autocomplete="off"
              placeholder="13 digits"
              maxlength="17"
              required
              aria-describedby="bk-ref-error"
            />
            <p class="field__error" id="bk-ref-error" aria-live="polite"></p>
          </div>
          <div class="alert" role="alert" tabindex="-1" data-submit-error hidden>
            <strong>We couldn't send your request.</strong>
            <span>Nothing is lost: your details and screenshot are still here. Check your connection, then try again.</span>
          </div>

          <Fragment slot="actions">
            <Button variant="ghost" arrow={false} data-back>Back</Button>
            <Button type="submit" data-submit><span data-submit-label>Submit request</span></Button>
          </Fragment>
        </BookingStep>
      </form>

      <section class="pending" data-step="pending" aria-labelledby="pending-title" hidden>
        <h3 id="pending-title" class="pending__status display" tabindex="-1">Pending review</h3>
        <p class="pending__code">
          Booking code <strong class="tabular" data-code></strong>
        </p>
        <p class="pending__lead">
          Payment submitted, awaiting confirmation. Your slot is not confirmed until our staff verify your payment.
        </p>
        <p>
          We will message you by email and SMS once our staff approve or reject your request. Keep your booking code for any
          questions.
        </p>
        <dl class="review" data-pending-review></dl>
        <p class="pending__demo" data-demo-note hidden>
          Demo mode: no data was sent. Set the booking endpoint in src/data/site-config.ts to receive requests.
        </p>
        <Button variant="ghost" arrow={false} data-restart>Start another request</Button>
      </section>

      <aside class="ticket" aria-label="Your request so far" data-ticket>
        <p class="ticket__title">Your request</p>
        <dl>
          <div><dt>Court</dt><dd data-sum="court">–</dd></div>
          <div><dt>Date</dt><dd data-sum="date">–</dd></div>
          <div><dt>Time</dt><dd data-sum="time">–</dd></div>
          <div><dt>Duration</dt><dd data-sum="hours">–</dd></div>
        </dl>
        <div class="ticket__total">
          <span>Total</span>
          <strong class="display tabular" data-sum="total">–</strong>
        </div>
        <p class="ticket__note" data-sum="rate"></p>
      </aside>
    </div>
  </div>
</section>

<script>
  import '../../scripts/booking';
  import '../../scripts/court-map';
</script>

<style>
  .booking {
    padding: var(--space-10) 0;
    background: var(--color-paper);
    border-top: var(--rule);
    border-bottom: var(--rule);
  }

  .booking__layout {
    display: grid;
    grid-template-columns: 200px 1fr 300px;
    gap: var(--space-8);
    align-items: start;
    margin-top: var(--space-8);
  }

  /* Step 1 holds the court map, so the form takes the ticket's column; the map's own summary stands in for the ticket */
  .booking__layout[data-step='slot'] {
    grid-template-columns: 200px 1fr;
  }

  .booking__layout[data-step='slot'] .ticket {
    display: none;
  }

  /* Progress rail */
  .progress {
    position: sticky;
    top: calc(var(--header-h) + var(--space-6));
    display: grid;
    gap: 0;
    --fill: 0;
  }

  .progress::before,
  .progress::after {
    content: '';
    position: absolute;
    left: 15px;
    top: 16px;
    width: 2px;
    bottom: 16px;
    background: var(--color-ink-faint);
  }

  /* The ink fill scales down the track (transform only); booking.ts sets --fill from 0 to 1 */
  .progress::after {
    background: var(--color-ink);
    transform: scaleY(var(--fill));
    transform-origin: top center;
    transition: transform var(--motion-fill) var(--ease-motion);
  }

  .progress li {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-2) 0;
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-ink-soft);
  }

  .progress__dot {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border: 1.5px solid var(--color-ink);
    border-radius: var(--radius-round);
    background: var(--color-paper);
    font-size: 13px;
    font-weight: 700;
    color: var(--color-ink);
    transition:
      background-color var(--motion-hover) var(--ease-motion),
      color var(--motion-hover) var(--ease-motion);
  }

  .progress li[data-done] .progress__dot {
    background: var(--color-ink);
    color: var(--color-paper);
  }

  .progress li[aria-current='step'] {
    color: var(--color-ink);
    font-weight: 700;
  }

  .progress li[aria-current='step'] .progress__dot {
    background: var(--color-ball);
    color: var(--color-ink);
  }

  /* Form */
  .booking__form,
  .pending {
    min-width: 0;
  }

  .group {
    margin: 0;
    padding: 0;
    border: 0;
    min-width: 0;
  }

  .group legend,
  .field label:not(.check),
  .label {
    display: block;
    margin-bottom: var(--space-2);
    padding: 0;
    font-size: var(--text-sm);
    font-weight: 700;
  }

  .row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-5);
  }

  .field {
    display: grid;
    align-content: start;
  }

  .field--narrow {
    max-width: 260px;
  }

  .optional {
    font-weight: 400;
    color: var(--color-ink-soft);
  }

  .field input:not([type='checkbox'], [type='file']),
  .field select,
  .field textarea {
    width: 100%;
    min-height: 52px;
    padding: var(--space-3) 14px;
    border: 1.5px solid var(--color-ink);
    border-radius: var(--radius-none);
    background: var(--color-on-dark);
    font-size: 17px;
    color: var(--color-ink);
    transition: background-color var(--motion-quick) var(--ease-motion);
  }

  @media (hover: hover) {
    .field input:not([type='checkbox'], [type='file']):hover,
    .field select:hover,
    .field textarea:hover {
      background-color: var(--color-paper-shade);
    }
  }

  .field input:not([type='checkbox'], [type='file']):focus,
  .field select:focus,
  .field textarea:focus {
    background-color: var(--color-on-dark);
  }

  .field select {
    appearance: none;
    padding-right: 44px;
    background-image:
      linear-gradient(45deg, transparent 50%, var(--color-ink) 50%),
      linear-gradient(135deg, var(--color-ink) 50%, transparent 50%);
    background-position:
      calc(100% - 22px) 50%,
      calc(100% - 16px) 50%;
    background-size: 6px 6px;
    background-repeat: no-repeat;
    cursor: pointer;
  }

  .field input[type='date'] {
    color-scheme: light;
    cursor: pointer;
  }

  .field input[type='date']::-webkit-calendar-picker-indicator {
    cursor: pointer;
    opacity: 0.8;
  }

  .field textarea {
    resize: vertical;
    line-height: var(--leading-body);
  }

  .field input::placeholder,
  .field textarea::placeholder {
    color: #6b746e;
  }

  .field [aria-invalid='true'] {
    border-color: var(--color-error);
    box-shadow: inset 0 0 0 1px var(--color-error);
  }

  .help {
    margin-top: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-ink-soft);
  }

  .group .help {
    margin: 0 0 var(--space-3);
  }

  .field__error {
    margin-top: var(--space-2);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-error);
  }

  .field__error:empty {
    display: none;
  }

  /* Choice tiles: crisp invert when selected */
  .tiles {
    display: grid;
    gap: var(--space-2);
  }

  .controls {
    display: grid;
    grid-template-columns: 1fr 1fr 1.4fr;
    gap: var(--space-5);
    align-items: start;
  }

  .tiles--courts {
    grid-template-columns: repeat(auto-fit, minmax(8.5rem, 1fr));
  }

  .tiles--duration {
    grid-template-columns: repeat(3, 1fr);
  }

  .tile {
    position: relative;
    display: grid;
    align-content: center;
    gap: 2px;
    min-height: 52px;
    padding: var(--space-2) var(--space-3);
    border: 1.5px solid var(--color-ink);
    background: var(--color-on-dark);
    cursor: pointer;
    transition:
      background-color var(--motion-quick) var(--ease-motion),
      color var(--motion-quick) var(--ease-motion);
  }

  .tiles--courts .tile {
    min-height: 68px;
  }

  .tile--compact {
    justify-items: center;
    text-align: center;
  }

  .tile input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .tile__main {
    font-size: 15px;
    font-weight: 700;
  }

  .tile__sub {
    font-size: var(--text-xs);
    color: var(--color-ink-soft);
  }

  @media (hover: hover) {
    .tile:hover {
      background: var(--color-paper-shade);
    }
  }

  .tile:has(input:checked) {
    background: var(--color-ink);
    color: var(--color-paper);
  }

  .tile:has(input:checked) .tile__sub {
    color: rgb(239 232 216 / 0.8);
  }

  .tile:has(input:focus-visible) {
    outline: var(--focus-ring);
    outline-offset: 2px;
  }

  .tile:has(input:disabled) {
    border-color: var(--color-ink-faint);
    background: repeating-linear-gradient(-45deg, transparent 0 6px, rgb(21 32 26 / 0.06) 6px 7px), var(--color-paper);
    color: #8a918c;
    cursor: not-allowed;
  }

  .tile:has(input:disabled) .tile__main {
    text-decoration: line-through;
    font-weight: 500;
  }

  /* Review */
  .review {
    display: grid;
    border-top: var(--rule);
  }

  /* Rows are rendered by booking.ts, so they need :global to receive these styles */
  .review :global(div) {
    display: grid;
    grid-template-columns: 180px 1fr;
    gap: var(--space-4);
    padding: var(--space-3) 0;
    border-bottom: var(--rule-thin);
  }

  .review :global(dt) {
    font-size: var(--text-sm);
    color: var(--color-ink-soft);
  }

  .review :global(dd) {
    font-weight: 600;
  }

  .review :global(.review__total dd) {
    font-family: var(--font-display);
    font-size: var(--display-sm);
    font-weight: 800;
    line-height: 1;
  }

  .policy {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-5);
    background: var(--color-paper-shade);
  }

  .policy h4 {
    font-size: var(--text-base);
    font-weight: 700;
  }

  .policy p {
    font-size: 15px;
    color: var(--color-ink-soft);
  }

  .check {
    display: flex;
    gap: var(--space-3);
    align-items: flex-start;
    font-size: var(--text-base);
    font-weight: 500;
    cursor: pointer;
  }

  .check input {
    flex: none;
    width: 22px;
    height: 22px;
    margin: 1px 0 0;
    accent-color: var(--color-ink);
  }

  /* Payment */
  .pay {
    display: grid;
    grid-template-columns: 240px 1fr;
    gap: var(--space-7);
    align-items: start;
  }

  .pay__qr {
    border: var(--rule);
    background: var(--color-on-dark);
  }

  .pay__label {
    font-size: var(--text-sm);
    font-weight: 700;
  }

  .pay__amount {
    font-size: var(--display-lg);
    line-height: 0.85;
  }

  .pay__account {
    display: grid;
    gap: var(--space-3);
    margin: var(--space-5) 0;
    padding: var(--space-4) 0;
    border-top: var(--rule);
    border-bottom: var(--rule-thin);
  }

  .pay__account dt {
    font-size: var(--text-sm);
    color: var(--color-ink-soft);
  }

  .pay__account dd {
    font-size: var(--text-lg);
    font-weight: 700;
  }

  /* Upload */
  .upload {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 220px;
    padding: var(--space-5);
    border: 1.5px dashed var(--color-ink);
    background: var(--color-on-dark);
    text-align: center;
    cursor: pointer;
    transition: background-color var(--motion-quick) var(--ease-motion);
  }

  @media (hover: hover) {
    .upload:hover {
      background: var(--color-paper);
    }
  }

  .upload:has(input:focus-visible) {
    outline: var(--focus-ring);
    outline-offset: 3px;
  }

  .upload:has(input[aria-invalid='true']) {
    border-color: var(--color-error);
  }

  .upload input {
    position: absolute;
    inset: 0;
    opacity: 0;
    cursor: pointer;
  }

  .upload__prompt {
    display: grid;
    gap: var(--space-1);
    color: var(--color-ink-soft);
  }

  .upload__prompt strong {
    font-size: 17px;
    color: var(--color-ink);
    text-decoration: underline;
    text-underline-offset: 5px;
    text-decoration-color: var(--color-court);
  }

  .upload__preview {
    display: flex;
    justify-content: center;
    width: 100%;
  }

  .upload__preview :global(img) {
    max-height: 320px;
    width: auto;
    border: var(--rule-thin);
  }

  .alert {
    display: grid;
    gap: var(--space-1);
    padding: var(--space-4) var(--space-5);
    border: 1.5px solid var(--color-error);
    background: #fbeceb;
    color: var(--color-error);
  }

  .alert span {
    color: var(--color-ink);
  }

  /* Pending */
  .pending {
    display: grid;
    gap: var(--space-5);
    justify-items: start;
    animation: pending-in var(--motion-reveal) var(--ease-motion);
  }

  .pending__status {
    padding: var(--space-3) var(--space-5) var(--space-2);
    background: var(--color-court);
    color: var(--color-on-dark);
    font-size: var(--display-md);
    line-height: 0.9;
    outline: none;
  }

  .pending__code {
    font-size: var(--text-md);
  }

  .pending__code strong {
    display: block;
    font-family: var(--font-display);
    font-size: var(--display-md);
    font-weight: 800;
    line-height: 1;
    letter-spacing: 0.01em;
  }

  .pending__lead {
    font-size: var(--text-lg);
    font-weight: 700;
    line-height: 1.3;
