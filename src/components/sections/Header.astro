---
/** Masthead: wordmark, nav, plain-text trust details and the persistent Book a Court button. */
import { site } from '../../data/site-config';
import Button from '../ui/Button.astro';
import Wordmark from '../ui/Wordmark.astro';
---

<header class="masthead">
  <div class="container masthead__inner">
    <a class="masthead__logo" href="#top" aria-label={`${site.name}, back to top`}>
      <Wordmark />
    </a>
    <nav aria-label="Main">
      <ul class="nav">
        {
          site.nav.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
    <ul class="facts" aria-label="Club facts">
      {site.trust.map((fact) => <li>{fact}</li>)}
    </ul>
    <Button href="#booking" size="md" arrow={false}>{site.cta.book}</Button>
  </div>
</header>

<style>
  .masthead {
    position: sticky;
    top: 0;
    z-index: 50;
    height: var(--header-h);
    background: var(--color-paper);
    border-bottom: var(--rule);
  }

  .masthead__inner {
    height: 100%;
    display: flex;
    align-items: center;
    gap: 56px;
  }

  .masthead__logo {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
  }

  .nav {
    display: flex;
    gap: var(--space-6);
  }

  .nav a {
    position: relative;
    padding: 6px 0;
    font-size: 15px;
    font-weight: 500;
    text-decoration: none;
  }

  /* Ink underline drawn in from the left */
  .nav a::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: 2px;
    background: var(--color-ink);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform var(--motion-hover) var(--ease-motion);
  }

  .nav a:focus-visible::after {
    transform: scaleX(1);
  }

  @media (hover: hover) {
    .nav a:hover::after {
      transform: scaleX(1);
    }
  }

  .facts {
    display: flex;
    margin-left: auto;
    margin-right: -28px;
    font-size: 13px;
    font-weight: 500;
    color: var(--color-ink-soft);
  }

  .facts li {
    padding: 0 var(--space-3);
    line-height: 1.1;
    border-left: var(--rule-thin);
  }

  .facts li:first-child {
    border-left: 0;
  }
</style>
