---
/**
 * Hero: the Editorial Sport spread from the bakeoff, recreated.
 * Paper column with the oversized headline; full-height photo on the right; a stamp on the seam;
 * the quick-book slab (step 1 of the booking flow) straddling the seam.
 */
import { Image } from 'astro:assets';
import { site } from '../../data/site-config';
import { photos } from '../../data/photos';
import { groups, startHours } from '../../utils/slots';
import { formatHour, formatPeso, toTimeValue } from '../../utils/format';
import Button from '../ui/Button.astro';

// PLACEHOLDER: replace with the club's real photo (see src/data/photos.ts)
const heroPhoto = photos['golden-hour-lunge'];
const defaultStart = 19;
---

<section class="hero" aria-labelledby="hero-title">
  <figure class="hero__photo">
    <Image
      src={heroPhoto.src}
      alt={heroPhoto.alt}
      widths={[700, 1050, 1400]}
      sizes="700px"
      loading="eager"
      fetchpriority="high"
      style={`object-position: ${heroPhoto.focus}`}
    />
    <figcaption>Photo: {heroPhoto.credit}</figcaption>
  </figure>

  <div class="stamp" aria-hidden="true">
    <svg viewBox="0 0 152 152">
      <defs>
        <path id="stamp-ring" d="M76,76 m-58,0 a58,58 0 1,1 116,0 a58,58 0 1,1 -116,0"></path>
      </defs>
      <text><textPath href="#stamp-ring" textLength="356" lengthAdjust="spacing">{site.stampText}</textPath></text>
    </svg>
    <p class="stamp__price">
      <b>{formatPeso(site.priceFrom)}</b>
      <span>per hour</span>
    </p>
  </div>

  <div class="container hero__inner">
    <div class="hero__copy">
      <h1 id="hero-title" class="headline display" aria-label={site.headlineLines.join(' ')}>
        {
          site.headlineLines.map((line, i) => (
            <span class:list={['line', { 'line--highlight': i === site.headlineHighlight }]} aria-hidden="true">
              <span>{line}</span>
            </span>
          ))
        }
      </h1>
      <p class="lede">{site.heroLede}</p>
      <div class="actions">
        <Button href="#booking">{site.cta.book}</Button>
        <a class="text-link" href="#courts">{site.cta.rates}</a>
        <a class="text-link" href="#how-booking-works">{site.cta.how}</a>
      </div>
    </div>

    <div class="slab on-dark">
      <form class="slab__form" action="#booking" method="get" data-quickbook aria-label="Check court availability">
        <div class="cell">
          <label for="qb-date">Date</label>
          <input id="qb-date" name="date" type="date" required />
        </div>
        <div class="cell cell--select">
          <label for="qb-time">Time</label>
          <select id="qb-time" name="time" required>
            {
              startHours.map((h) => (
                <option value={toTimeValue(h)} selected={h === defaultStart}>
                  {formatHour(h)} – {formatHour(h + 1)}
                </option>
              ))
            }
          </select>
        </div>
        <fieldset class="cell">
          <legend>Court type</legend>
          <div class="choices">
            {
              groups.map((g, i) => (
                <label>
                  <input type="radio" name="court" value={`any-${g.id}`} checked={i === 0} />
                  <span>{g.shortName}</span>
                  <small>{g.countLabel}</small>
                </label>
              ))
            }
          </div>
        </fieldset>
        <Button type="submit" variant="ball" class="slab__submit">{site.cta.check}</Button>
      </form>
      <div class="slab__foot">
        <p>{site.policy.reassurance}</p>
        <a href="#contact">{site.cta.contact}</a>
      </div>
    </div>
  </div>
</section>

<script>
  import '../../scripts/quickbook';
</script>

<style>
  .hero {
    position: relative;
    height: calc(var(--hero-h) - var(--header-h));
    overflow: hidden;
  }

  .hero__inner {
    height: 100%;
  }

  /* Photo column, bleeding to the right edge */
  .hero__photo {
    position: absolute;
    inset: 0 0 0 var(--seam);
    background: var(--color-ink);
  }

  .hero__photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__photo::after {
    content: '';
    position: absolute;
    inset: 0 auto 0 0;
    width: 1.5px;
    background: var(--color-ink);
  }

  .hero__photo figcaption {
    position: absolute;
    right: var(--space-5);
    bottom: 20px;
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.02em;
    color: var(--color-on-dark-soft);
  }

  /* Stamp on the seam */
  .stamp {
    position: absolute;
    top: 40px;
    left: calc(var(--seam) - 76px);
    z-index: 3;
    width: 152px;
    height: 152px;
    display: grid;
    place-items: center;
    border-radius: var(--radius-round);
    background: var(--color-ball);
    color: var(--color-ink);
    box-shadow: var(--shadow-stamp);
  }

  .stamp svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    transform: rotate(-24deg);
  }

  .stamp text {
    font: 700 13px var(--font-body);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    fill: currentColor;
  }

  .stamp__price {
    position: relative;
    text-align: center;
    line-height: 1;
  }

  .stamp__price b {
    display: block;
    font: 900 40px / 0.9 var(--font-display);
    letter-spacing: 0.01em;
  }

  .stamp__price span {
    font-size: 11px;
    font-weight: 600;
  }

  /* Copy column */
  .hero__copy {
    position: absolute;
    top: 22px;
    left: 0;
    width: 600px;
  }

  .headline {
    font-size: var(--display-xl);
    line-height: var(--leading-tight);
  }

  .line {
    display: block;
    padding-top: 0.06em;
    overflow: hidden;
  }

  .line > span {
    display: inline-block;
    animation: wipe var(--duration-slow) var(--ease-out) both;
  }

  .line:nth-child(2) > span {
    animation-delay: 0.08s;
  }

  .line:nth-child(3) > span {
    animation-delay: 0.16s;
  }

  .line--highlight > span {
    margin-left: -0.04em;
    padding: 0 0.04em;
    background: linear-gradient(transparent 58%, var(--color-ball) 58%, var(--color-ball) 92%, transparent 92%);
  }

  .lede {
    max-width: 500px;
    margin-top: 22px;
    font-size: var(--text-md);
    text-wrap: pretty;
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 28px;
    margin-top: var(--space-5);
  }

  .text-link {
    padding: var(--space-2) 0;
    font-weight: 600;
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 6px;
    text-decoration-color: var(--color-court);
    transition: color var(--duration-fast);
  }

  .text-link:hover {
    color: var(--color-court);
  }

  /* Quick-book slab, straddling the seam */
  .slab {
    position: absolute;
    left: 0;
    bottom: 40px;
    z-index: 3;
    width: 1000px;
    background: var(--color-court);
    color: var(--color-on-dark);
    box-shadow: var(--shadow-slab);
  }

  .slab__form {
    display: grid;
    grid-template-columns: 186px 252px 1fr auto;
    gap: 2px;
    padding: 2px;
  }

  .cell {
    position: relative;
    display: grid;
    align-content: center;
    gap: var(--space-1);
    min-width: 0;
    min-height: 78px;
    margin: 0;
    padding: 14px 20px;
    border: 0;
    background: var(--color-court-deep);
    transition: background-color var(--duration-fast);
  }

  .cell:hover {
    background: var(--color-court-hover);
  }

  .cell:focus-within {
    box-shadow: inset 0 0 0 2px var(--color-ball);
  }

  .cell label,
  .cell legend {
    padding: 0;
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--color-on-dark-soft);
  }

  .cell legend {
    float: left;
    width: 100%;
    margin-bottom: var(--space-1);
  }

  .cell input,
  .cell select {
    width: 100%;
    padding: 0;
    border: 0;
    background: transparent;
    font-size: var(--text-md);
    font-weight: 600;
    line-height: 1.25;
    color: var(--color-on-dark);
    color-scheme: dark;
    cursor: pointer;
    appearance: none;
  }

  .cell select {
    padding-right: 26px;
  }

  .cell select option {
    color: var(--color-ink);
    background: var(--color-on-dark);
  }

  .cell input:focus-visible,
  .cell select:focus-visible {
    outline: none;
  }

  .cell--select::after {
    content: '';
    position: absolute;
    right: 20px;
    top: 58%;
    width: 8px;
    height: 8px;
    border-right: 2px solid var(--color-on-dark);
    border-bottom: 2px solid var(--color-on-dark);
    transform: translateY(-50%) rotate(45deg);
    pointer-events: none;
  }

  .choices {
    clear: both;
    display: flex;
    gap: var(--space-2);
  }

  .choices label {
    flex: 1;
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 6px;
    padding: 7px var(--space-2);
    border: 1.5px solid var(--color-on-dark-soft);
    font-size: 15px;
    letter-spacing: 0;
    color: var(--color-on-dark);
    white-space: nowrap;
    cursor: pointer;
    transition:
      background-color var(--duration-fast),
      color var(--duration-fast),
      border-color var(--duration-fast);
  }

  .choices label:hover {
    border-color: var(--color-on-dark);
  }

  .choices small {
    font-size: var(--text-xs);
    font-weight: 500;
    opacity: 0.85;
  }

  .choices input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .choices label:has(input:checked) {
    background: var(--color-on-dark);
    border-color: var(--color-on-dark);
    color: var(--color-court);
  }

  .choices label:has(input:focus-visible) {
    outline: var(--focus-ring-on-dark);
    outline-offset: 2px;
  }

  .slab :global(.slab__submit) {
    height: auto;
    padding: 0 30px;
    font-size: 17px;
    font-weight: 700;
  }

  .slab__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
    padding: var(--space-3) 22px 14px;
    font-size: var(--text-sm);
    color: var(--color-on-dark-soft);
  }

  .slab__foot a {
    font-weight: 600;
    color: var(--color-on-dark);
    white-space: nowrap;
    text-decoration: underline;
    text-decoration-thickness: 1.5px;
    text-underline-offset: 5px;
    text-decoration-color: rgb(255 255 255 / 0.5);
  }

  .slab__foot a:hover {
    text-decoration-color: var(--color-ball);
  }

  @keyframes wipe {
    from {
      transform: translateY(100%);
    }
  }
</style>
