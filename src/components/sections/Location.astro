---
/** Location & Contact: address, hours, directions, tap-to-call, email, Facebook and Messenger. */
import { site, fullAddress } from '../../data/site-config';
import Button from '../ui/Button.astro';
import SectionHeading from '../ui/SectionHeading.astro';

const copy = site.sections.contact;
const contacts = [
  { label: 'Call or text', value: site.phone.display, href: `tel:${site.phone.e164}`, external: false },
  { label: 'Email', value: site.email, href: `mailto:${site.email}`, external: false },
  { label: 'Facebook', value: `${site.shortName} on Facebook`, href: site.links.facebook, external: true },
  { label: 'Messenger', value: site.cta.messenger, href: site.links.messenger, external: true },
];
---

<section class="location on-dark" id="contact" aria-labelledby="contact-title">
  <div class="container">
    <SectionHeading id="contact-title" lines={copy.lines} tone="dark">{copy.lede}</SectionHeading>

    <div class="location__grid">
      <div class="where">
        <address class="where__address display">
          <span>{site.address.street}</span>
          <span>{site.address.locality} {site.address.postalCode}</span>
        </address>
        <p class="where__hours">
          <span>Hours</span>
          <strong>{site.hours.label}</strong>
        </p>
        <div class="where__actions">
          <Button href={site.links.maps} variant="ball" external aria-label={`${site.cta.directions} to ${fullAddress} (opens Google Maps)`}>
            {site.cta.directions}
          </Button>
          <Button href="#booking">{site.cta.book}</Button>
        </div>
      </div>

      <ul class="contacts">
        {
          contacts.map((c) => (
            <li>
              <a href={c.href} {...(c.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>
                <span class="contacts__label">{c.label}</span>
                <span class="contacts__value">{c.value}</span>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" aria-hidden="true">
                  <path d={c.external ? 'M8 16L16 8M9 8h7v7' : 'M5 12h14M13 6l6 6-6 6'} />
                </svg>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .location {
    padding: var(--space-10) 0;
    background: var(--color-court);
    color: var(--color-on-dark);
  }

  .location__grid {
    display: grid;
    grid-template-columns: 1fr 520px;
    gap: var(--space-9);
    margin-top: var(--space-8);
  }

  .where__address {
    display: grid;
    font-style: normal;
    font-size: var(--display-sm);
    line-height: 1;
  }

  .where__hours {
    display: grid;
    gap: var(--space-1);
    margin-top: var(--space-6);
  }

  .where__hours span {
    font-size: var(--text-sm);
    color: var(--color-on-dark-soft);
  }

  .where__hours strong {
    font-size: var(--text-lg);
  }

  .where__actions {
    display: flex;
    gap: var(--space-4);
    margin-top: var(--space-7);
  }

  .contacts {
    border-top: 1.5px solid var(--color-on-dark);
  }

  .contacts a {
    display: grid;
    grid-template-columns: 140px 1fr 24px;
    align-items: center;
    gap: var(--space-4);
    padding: 22px 0;
    border-bottom: 1px solid rgb(255 255 255 / 0.35);
    text-decoration: none;
    transition: padding-left var(--duration-base) var(--ease-out);
  }

  .contacts a:hover {
    padding-left: var(--space-2);
  }

  .contacts__label {
    font-size: var(--text-sm);
    color: var(--color-on-dark-soft);
  }

  .contacts__value {
    font-size: 20px;
    font-weight: 600;
  }

  .contacts svg {
    width: 22px;
    height: 22px;
  }
</style>
