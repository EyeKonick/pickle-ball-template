---
/**
 * The hero's square, arrowed button, reused for every call to action.
 * Renders a link when `href` is set, otherwise a <button>.
 */
import type { HTMLAttributes } from 'astro/types';

interface Props {
  href?: string;
  type?: 'button' | 'submit';
  /** ink: primary on paper · ball: primary on court blue · ghost: outline on paper · ghost-light: outline on dark */
  variant?: 'ink' | 'ball' | 'ghost' | 'ghost-light';
  size?: 'md' | 'lg';
  arrow?: boolean;
  external?: boolean;
  class?: string;
  [key: `data-${string}`]: string | undefined;
  'aria-label'?: string;
}

const {
  href,
  type = 'button',
  variant = 'ink',
  size = 'lg',
  arrow = true,
  external = false,
  class: className,
  ...rest
} = Astro.props;

const classes = ['btn', `btn--${variant}`, `btn--${size}`, className].filter(Boolean).join(' ');
const linkAttrs: HTMLAttributes<'a'> = external ? { target: '_blank', rel: 'noopener noreferrer' } : {};
---

{
  href ? (
    <a class={classes} href={href} {...linkAttrs} {...rest}>
      <slot />
      {arrow && (
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" aria-hidden="true">
          <path d="M5 12h14M13 6l6 6-6 6" />
        </svg>
      )}
    </a>
  ) : (
    <button class={classes} type={type} {...rest}>
      <slot />
      {arrow && (
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" aria-hidden="true">
          <path d="M5 12h14M13 6l6 6-6 6" />
        </svg>
      )}
    </button>
  )
}

<style>
  .btn {
    --btn-accent: var(--color-ball); /* the bar that slides in along the bottom on hover and focus */
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    border: 0;
    border-radius: var(--radius-none);
    font-family: var(--font-body);
    font-weight: 600;
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
    transition:
      background-color var(--motion-hover) var(--ease-motion),
      color var(--motion-hover) var(--ease-motion),
      box-shadow var(--motion-hover) var(--ease-motion);
  }

  .btn::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: 3px;
    background: var(--btn-accent);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform var(--motion-hover) var(--ease-motion);
  }

  .btn:focus-visible::after {
    transform: scaleX(1);
  }

  .btn svg {
    width: 18px;
    height: 18px;
    flex: none;
    transition: transform var(--motion-hover) var(--ease-motion);
  }

  .btn--md {
    height: 48px;
    padding: 0 22px;
    font-size: 15px;
  }

  .btn--lg {
    height: 56px;
    padding: 0 28px;
    font-size: var(--text-base);
  }

  .btn--ink {
    background: var(--color-ink);
    color: var(--color-paper);
  }

  .btn--ball {
    --btn-accent: var(--color-ink);
    background: var(--color-ball);
    color: var(--color-ink);
  }

  .btn--ghost {
    --btn-accent: var(--color-ink);
    background: transparent;
    color: var(--color-ink);
    box-shadow: inset 0 0 0 1.5px var(--color-ink);
  }

  .btn--ghost-light {
    background: transparent;
    color: var(--color-on-dark);
    box-shadow: inset 0 0 0 1.5px var(--color-on-dark-soft);
  }

  @media (hover: hover) {
    .btn:hover::after {
      transform: scaleX(1);
    }

    .btn--ball:hover {
      background: var(--color-ball-deep);
    }

    .btn--ghost:hover {
      background: var(--color-paper-shade);
    }

    .btn--ghost-light:hover {
      box-shadow: inset 0 0 0 1.5px var(--color-on-dark);
      background: rgb(255 255 255 / 0.08);
    }
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .btn:hover svg {
      transform: translateX(3px);
    }
  }

  .btn[aria-busy='true'] {
    opacity: 0.7;
    cursor: progress;
  }

  .btn:disabled {
    opacity: 0.45;
    cursor: not-allowed;
  }

  .btn:disabled::after {
    transform: scaleX(0);
  }
</style>
