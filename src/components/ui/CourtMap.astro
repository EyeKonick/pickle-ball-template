---
/**
 * Bird's-eye floor plan of the club for Booking step 1, drawn from courts.json (`map` and each court's `map`).
 * Every court is a focusable button; src/scripts/court-map.ts sets its status, selection and tooltip.
 * Each court carries one drawing per status, and the script cross-fades between them.
 * Until the script has run (or if JavaScript is off or fails) a plain table of courts shows instead.
 */
import { courts, groups, floorPlan, rates } from '../../utils/slots';
import { formatPeso } from '../../utils/format';
import MapLegend from './MapLegend.astro';

const { width: W, length: L } = floorPlan.court;
const kitchen = (L * 7) / 44; // non-volley zone depth: 7 ft on a 44 ft court
const net = L / 2;
const b = floorPlan.building;
const bottom = b.y + b.height;
const entranceMid = floorPlan.entrance.x + floorPlan.entrance.width / 2;

const zones = floorPlan.zones.map((z) => ({ ...z, group: groups.find((g) => g.id === z.group)! }));

// Reveal order: zone by zone (in courts.json group order), then by court number
const ordered = [...courts].sort(
  (a, c) => groups.findIndex((g) => g.id === a.group) - groups.findIndex((g) => g.id === c.group) || a.number - c.number,
);

const layers = [
  { status: 'available', label: 'Open' },
  { status: 'pending', label: 'Pending' },
  { status: 'booked', label: 'Booked' },
  { status: 'closed', label: 'Closed' },
] as const;

const rateLabel = (planId: string) => {
  const plan = rates[planId as 'indoor' | 'outdoor'];
  if (!plan) return '';
  const off = 'offPeak' in plan ? plan.offPeak : undefined;
  return off
    ? `${formatPeso(plan.standard)} an hour, ${formatPeso(off.amount)} off-peak, ${off.label}`
    : `${formatPeso(plan.standard)} an hour`;
};
---

<div class="map" data-court-map>
  <div class="map__plan" hidden data-map-only>
    <div class="map__canvas" data-map-canvas>
      <svg
        class="map__svg"
        viewBox={`0 0 ${floorPlan.width} ${floorPlan.height}`}
        role="group"
        aria-label="Court map: choose an open court"
        data-map-svg
      >
        <defs>
          <pattern id="cm-hatch" width="2.4" height="2.4" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
            <rect class="hatch-ground" width="2.4" height="2.4"></rect>
            <line class="hatch-line" x1="0" y1="0" x2="0" y2="2.4"></line>
          </pattern>
          <filter id="cm-blur" x="-30%" y="-30%" width="160%" height="160%">
            <feGaussianBlur stdDeviation="2.2"></feGaussianBlur>
          </filter>
          <g id="cm-lines" class="lines">
            <path d={`M0 ${net - kitchen}H${W}M0 ${net + kitchen}H${W}M${W / 2} 0V${net - kitchen}M${W / 2} ${net + kitchen}V${L}`}></path>
            <path class="lines__net" d={`M-1.4 ${net}H${W + 1.4}`}></path>
          </g>
        </defs>

        {
          zones.map((z) => (
            <g class="zone" data-zone={z.group.id}>
              <rect class="zone__wash" x={z.x} y={z.y} width={z.width} height={z.height} />
              {z.covered && <rect class="zone__roof" x={z.x} y={z.y} width={z.width} height={z.height} />}
              <rect class="zone__band" x={z.x + 10} y={z.y + 5.6} width="40" height="7.4" data-zone-band />
              <text class="zone__label" x={z.x + 12} y={z.y + 11.8} data-zone-label>
                {z.group.name}
              </text>
              <text class="zone__sub" x={z.x + 12} y={z.y + 18.6}>
                {z.group.courtsLabel}
              </text>
            </g>
          ))
        }

        <g class="building" aria-hidden="true">
          <rect class="building__wall" x={b.x} y={b.y} width={b.width} height={b.height}></rect>
          <line class="building__divide" x1={b.x} x2={b.x + b.width} y1={zones[0].y + zones[0].height} y2={zones[0].y + zones[0].height}></line>
          <rect class="building__door" x={floorPlan.entrance.x} y={bottom - 1} width={floorPlan.entrance.width} height="2"></rect>
          <path
            class="building__jamb"
            d={`M${floorPlan.entrance.x} ${bottom - 2}V${bottom + 2}M${floorPlan.entrance.x + floorPlan.entrance.width} ${bottom - 2}V${bottom + 2}`}
          ></path>
          <path class="building__arrow" d={`M${entranceMid} ${bottom + 7.5}V${bottom + 2.2}M${entranceMid - 1.8} ${bottom + 4}L${entranceMid} ${bottom + 2.2}L${entranceMid + 1.8} ${bottom + 4}`}></path>
          <text class="building__note" x={entranceMid} y={bottom + 12.2} text-anchor="middle">Entrance</text>
          <rect
            class="building__desk"
            x={floorPlan.reception.x}
            y={floorPlan.reception.y}
            width={floorPlan.reception.width}
            height={floorPlan.reception.height}
          ></rect>
          <text
            class="building__note"
            x={floorPlan.reception.x + floorPlan.reception.width / 2}
            y={floorPlan.reception.y + floorPlan.reception.height / 2 + 1.2}
            text-anchor="middle"
          >
            Reception
          </text>
        </g>

        {
          ordered.map((court, i) => (
            <g transform={`translate(${court.map.x} ${court.map.y})`}>
              <g class="slot" style={`--i: ${i}`}>
                <g
                  class="court"
                  role="button"
                  tabindex="0"
                  aria-pressed="false"
                  aria-disabled="true"
                  aria-label={court.name}
                  data-map-court={court.id}
                  data-status="closed"
                >
                  <rect class="court__hit" x="-5" y="-5" width={W + 10} height={L + 10} />
                  <rect class="court__shadow" x="0.5" y="2.5" width={W - 1} height={L - 1} filter="url(#cm-blur)" />
                  <g class="court__body">
                    <g class="court__layers">
                      {layers.map((layer) => (
                        <g class={`layer layer--${layer.status}`} data-layer={layer.status}>
                          <rect class="surface" width={W} height={L} />
                          <use href="#cm-lines" />
                          <text class="num" x={W / 2} y={net + 4.9} text-anchor="middle">
                            {court.number}
                          </text>
                          <text class="lbl" x={W / 2} y={net + kitchen + (net - kitchen) / 2 + 1.3} text-anchor="middle">
                            {layer.label}
                          </text>
                        </g>
                      ))}
                    </g>
                    <rect class="court__ring-edge" x="-2.7" y="-2.7" width={W + 5.4} height={L + 5.4} />
                    <rect class="court__ring" x="-1.6" y="-1.6" width={W + 3.2} height={L + 3.2} />
                    <g class="court__check" transform={`translate(${W / 2} ${(net - kitchen) / 2})`}>
                      <circle r="4.2" />
                      <path d="M-2 0.1L-0.6 1.6L2.1 -1.4" />
                    </g>
                  </g>
                  <rect class="court__focus" x="-4" y="-4" width={W + 8} height={L + 8} />
                </g>
              </g>
            </g>
          ))
        }
      </svg>
      <div class="tip" aria-hidden="true" data-tip hidden>
        <p class="tip__name display" data-tip-name></p>
        <p class="tip__zone" data-tip-zone></p>
        <p class="tip__status"><span class="tip__chip" data-tip-chip></span><span data-tip-time></span></p>
        <p class="tip__line" data-tip-reason></p>
        <p class="tip__line tabular" data-tip-rate></p>
      </div>
    </div>
    <MapLegend />
  </div>

  <div class="map__empty" hidden data-map-empty>
    <p class="map__empty-title display" data-empty-title></p>
    <p class="map__empty-text" data-empty-text></p>
    <button type="button" class="map__jump" data-empty-jump>
      <span data-empty-jump-label></span>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" aria-hidden="true">
        <path d="M5 12h14M13 6l6 6-6 6"></path>
      </svg>
    </button>
  </div>

  <p class="visually-hidden" aria-live="polite" data-map-live></p>

  <div class="fallback" data-map-fallback>
    <p class="fallback__note">The interactive court map needs JavaScript. Every court is listed here: choose your court, date and time in the form below.</p>
    <table>
      <thead>
        <tr><th scope="col">Court</th><th scope="col">Zone</th><th scope="col">Rate</th><th scope="col">About</th></tr>
      </thead>
      <tbody>
        {
          ordered.map((court) => (
            <tr>
              <th scope="row">{court.name}</th>
              <td>{groups.find((g) => g.id === court.group)?.name}</td>
              <td>{rateLabel(court.rate)}</td>
              <td>{court.description}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</div>

<style>
  .map {
    display: grid;
    gap: var(--space-5);
  }

  .map__plan {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 11rem;
    gap: var(--space-6);
    align-items: start;
    padding-top: var(--space-5);
    border-top: var(--rule);
  }

  .map__canvas {
    position: relative;
  }

  .map__svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
    font-family: var(--font-body);
  }

  /* Hatch pattern for pending courts */
  .hatch-ground {
    fill: var(--color-sand);
  }

  .hatch-line {
    stroke: var(--color-hatch);
    stroke-width: 0.9;
  }

  /* Floor plan */
  .building__wall {
    fill: none;
    stroke: var(--color-ink);
    stroke-width: 1.1;
  }

  .building__divide {
    stroke: var(--color-ink-faint);
    stroke-width: 0.3;
  }

  .building__door {
    fill: var(--color-paper);
  }

  .building__jamb,
  .building__arrow {
    fill: none;
    stroke: var(--color-ink);
    stroke-width: 0.6;
  }

  .building__desk {
    fill: none;
    stroke: var(--color-ink);
    stroke-width: 0.45;
  }

  .building__note {
    font-size: 3.4px;
    font-weight: 600;
    fill: var(--color-ink);
  }

  .zone__wash {
    fill: var(--color-paper-shade);
    opacity: 0;
    transition: opacity var(--motion-hover) var(--ease-motion);
  }

  /* Covered zones: a dashed roof line */
  .zone__roof {
    fill: none;
    stroke: var(--color-ink);
    stroke-width: 0.6;
    stroke-dasharray: 2.4 1.6;
  }

  .zone__band {
    fill: var(--color-ball);
    transform: scaleX(0);
    transform-box: fill-box;
    transform-origin: left center;
    transition: transform var(--motion-hover) var(--ease-motion);
  }

  .zone__label {
    font-family: var(--font-display);
    font-size: 6.6px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    fill: var(--color-ink);
  }

  .zone__sub {
    font-size: 3.5px;
    fill: var(--color-ink-soft);
  }

  /* The zone passed in from the hero strip (or a court's own zone) is highlighted */
  .zone.is-focus .zone__wash {
    opacity: 1;
  }

  .zone.is-focus .zone__band {
    transform: scaleX(1);
  }

  /* Courts */
  .court {
    cursor: not-allowed;
    outline: none;
  }

  .court[data-status='available'] {
    cursor: pointer;
  }

  .court__hit {
    fill: transparent;
  }

  .court__shadow {
    fill: rgb(21 32 26 / 0.55);
    opacity: 0;
    transition: opacity var(--motion-hover) var(--ease-motion);
  }

  .court__body {
    transition: transform var(--motion-hover) var(--ease-motion);
  }

  /* One drawing per status; the active one sits on top and fades in, the old one drops away after it */
  .layer {
    opacity: 0;
    transition: opacity 0s linear var(--motion-hover);
  }

  .layer.is-on {
    opacity: 1;
    transition: opacity var(--motion-hover) var(--ease-motion);
  }

  .surface {
    stroke: var(--color-ink);
    stroke-width: 0.5;
  }

  .lines {
    fill: none;
    stroke: currentColor;
    stroke-width: 0.4;
  }

  .lines__net {
    stroke-width: 0.9;
  }

  .num {
    font-family: var(--font-display);
    font-size: 14px;
    font-weight: 800;
    font-variant-numeric: tabular-nums;
    paint-order: stroke;
    stroke-width: 2.6;
    stroke-linejoin: round;
  }

  .lbl {
    font-size: 3.5px;
    font-weight: 700;
    paint-order: stroke;
    stroke-width: 1.8;
    stroke-linejoin: round;
  }

  .layer--available {
    color: var(--color-ink);
  }

  .layer--available .surface {
    fill: var(--color-ball);
  }

  .layer--available :is(.num, .lbl) {
    fill: var(--color-ink);
    stroke: var(--color-ball);
  }

  .layer--pending {
    color: var(--color-ink);
  }

  .layer--pending .surface {
    fill: url(#cm-hatch);
  }

  .layer--pending :is(.num, .lbl) {
    fill: var(--color-ink);
    stroke: var(--color-sand);
  }

  .layer--booked {
    color: rgb(239 232 216 / 0.45);
  }

  .layer--booked .surface {
    fill: var(--color-ink);
  }

  .layer--booked :is(.num, .lbl) {
    fill: var(--color-paper);
    stroke: var(--color-ink);
  }

  .layer--closed {
    color: rgb(107 116 110 / 0.55);
  }

  .layer--closed .surface {
    fill: var(--color-paper);
    stroke: var(--color-closed);
    stroke-width: 0.6;
    stroke-dasharray: 1.8 1.2;
  }

  .layer--closed .num {
    fill: var(--color-ink-soft);
    stroke: var(--color-paper);
  }

  .layer--closed .lbl {
    fill: var(--color-ink-soft);
    stroke: var(--color-paper);
  }

  /* Selected: lime outline edged in ink, and a check mark */
  .court__ring,
  .court__ring-edge {
    fill: none;
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
  }

  .court__ring {
    stroke: var(--color-ball);
    stroke-width: 1.8;
  }

  .court__ring-edge {
    stroke: var(--color-ink);
    stroke-width: 0.5;
  }

  .court__check {
    opacity: 0;
  }

  .court__check circle {
    fill: var(--color-ink);
  }

  .court__check path {
    fill: none;
    stroke: var(--color-ball);
    stroke-width: 0.9;
    stroke-linecap: square;
  }

  .court[aria-pressed='true'] :is(.court__ring, .court__ring-edge, .court__check) {
    opacity: 1;
  }

  .court.is-picked :is(.court__ring, .court__ring-edge) {
    animation: ring-settle var(--motion-hover) var(--ease-motion);
  }

  .court.is-picked .court__check {
    animation: check-in var(--motion-hover) var(--ease-motion);
  }

  /* Keyboard focus */
  .court__focus {
    fill: none;
    stroke: var(--color-ink);
    stroke-width: 0.9;
    opacity: 0;
  }

  .court:focus-visible .court__focus {
    opacity: 1;
  }

  /* Hover lift on open courts: the court rises a little and its shadow fades in underneath */
  @media (hover: hover) {
    .court[data-status='available']:hover .court__body {
      transform: translateY(calc(var(--motion-lift) / -3));
    }

    .court[data-status='available']:hover .court__shadow {
      opacity: 1;
    }
  }

  /* One-time reveal: courts fade up in a short stagger, zone by zone */
  .map__svg[data-reveal-pending] .slot {
    opacity: 0;
    transform: translateY(calc(var(--motion-distance) / 4));
  }

  .slot {
    transition:
      opacity var(--motion-reveal) var(--ease-motion),
      transform var(--motion-reveal) var(--ease-motion);
    transition-delay: calc(var(--i, 0) * var(--motion-stagger));
  }

  @keyframes ring-settle {
    from {
      opacity: 0;
      transform: scale(1.06);
    }
  }

  @keyframes check-in {
    from {
      opacity: 0;
    }
  }

  /* Tooltip */
  .tip {
    position: absolute;
    left: 0;
    top: 0;
    z-index: 2;
    width: 15.5rem;
    padding: var(--space-3) var(--space-4) var(--space-4);
    border: var(--rule);
    background: var(--color-on-dark);
    pointer-events: none;
    opacity: 0;
    transition: opacity var(--motion-quick) var(--ease-motion);
  }

  .tip.is-on {
    opacity: 1;
  }

  .tip__name {
    font-size: var(--text-lg);
    line-height: 1;
  }

  .tip__zone {
    margin-top: 2px;
    font-size: var(--text-sm);
    color: var(--color-ink-soft);
  }

  .tip__status {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-3);
    padding-top: var(--space-3);
    border-top: var(--rule-thin);
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .tip__chip {
    padding: 2px var(--space-2);
    border: 1.5px solid var(--color-ink);
    font-size: var(--text-xs);
    font-weight: 700;
  }

  .tip__chip[data-status='available'] {
    background: var(--color-ball);
  }

  .tip__chip[data-status='pending'] {
    background: var(--color-sand);
  }

  .tip__chip[data-status='booked'] {
    background: var(--color-ink);
    color: var(--color-paper);
  }

  .tip__chip[data-status='closed'] {
    border-style: dashed;
    border-color: var(--color-closed);
    color: var(--color-ink-soft);
  }

  .tip__line {
    margin-top: var(--space-1);
    font-size: var(--text-sm);
    color: var(--color-ink-soft);
  }

  .tip__line:empty {
    display: none;
  }

  /* Empty state: nothing open at the chosen time */
  .map__empty {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: var(--space-2) var(--space-6);
    padding: var(--space-5);
    border: 1.5px dashed var(--color-ink);
    background: var(--color-on-dark);
  }

  .map__empty-title {
    grid-column: 1;
    font-size: var(--display-sm);
    line-height: 0.95;
  }

  .map__empty-text {
    grid-column: 1;
    color: var(--color-ink-soft);
  }

  .map__jump {
    grid-column: 2;
    grid-row: 1 / span 2;
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    height: 48px;
    padding: 0 22px;
    border: 0;
    background: var(--color-ink);
    color: var(--color-paper);
    font: 600 15px/1 var(--font-body);
    cursor: pointer;
  }

  .map__jump svg {
    width: 18px;
    height: 18px;
    transition: transform var(--motion-hover) var(--ease-motion);
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .map__jump:hover svg {
      transform: translateX(3px);
    }
  }

  .map__jump:focus-visible {
    outline: var(--focus-ring);
    outline-offset: 3px;
  }

  /* No-JS fallback */
  .fallback {
    display: grid;
    gap: var(--space-4);
  }

  .fallback__note {
    padding: var(--space-3) var(--space-4);
    background: var(--color-paper-shade);
    font-size: var(--text-sm);
  }

  .fallback table {
    width: 100%;
    border-collapse: collapse;
    border-top: var(--rule);
    font-size: 15px;
  }

  .fallback :is(th, td) {
    padding: var(--space-3) var(--space-3) var(--space-3) 0;
    border-bottom: var(--rule-thin);
    text-align: left;
    vertical-align: top;
  }

  .fallback thead th {
    font-size: var(--text-sm);
    color: var(--color-ink-soft);
  }

  .fallback tbody th {
    white-space: nowrap;
  }
</style>
