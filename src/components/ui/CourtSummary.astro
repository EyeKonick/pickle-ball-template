---
/** The court picked on the map or in the form: court, date, time, duration and total. Filled by court-map.ts. */
---

<section class="pick" aria-labelledby="pick-title" hidden data-pick>
  <h4 id="pick-title" class="pick__title">Your court</h4>
  <dl class="pick__grid">
    <div class="pick__court">
      <dt>Court</dt>
      <dd class="display" data-pick-field="court"></dd>
      <dd class="pick__zone" data-pick-field="zone"></dd>
    </div>
    <div>
      <dt>Date</dt>
      <dd data-pick-field="date"></dd>
    </div>
    <div>
      <dt>Time</dt>
      <dd class="tabular" data-pick-field="time"></dd>
    </div>
    <div>
      <dt>Duration</dt>
      <dd data-pick-field="hours"></dd>
    </div>
    <div class="pick__total">
      <dt>Total</dt>
      <dd class="display tabular" data-pick-field="total"></dd>
    </div>
  </dl>
</section>

<style>
  .pick {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: stretch;
    border: var(--rule);
    background: var(--color-on-dark);
    animation: pick-in var(--motion-hover) var(--ease-motion);
  }

  .pick__title {
    display: grid;
    place-items: center;
    padding: var(--space-4) var(--space-3);
    border-right: 1.5px dashed var(--color-ink);
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 800;
    line-height: 1;
    text-transform: uppercase;
    writing-mode: vertical-rl;
    rotate: 180deg;
  }

  .pick__grid {
    display: grid;
    grid-template-columns: 1.1fr 1.3fr 1.4fr 0.9fr auto;
  }

  .pick__grid > div {
    display: grid;
    align-content: start;
    gap: var(--space-1);
    padding: var(--space-4) var(--space-5);
    border-left: var(--rule-thin);
  }

  .pick__grid > div:first-child {
    border-left: 0;
  }

  dt {
    font-size: var(--text-xs);
    color: var(--color-ink-soft);
  }

  dd {
    font-size: 15px;
    font-weight: 600;
  }

  .pick__court dd.display {
    font-size: var(--display-sm);
    line-height: 0.9;
  }

  .pick__zone {
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--color-ink-soft);
  }

  .pick__total {
    justify-items: end;
    text-align: right;
  }

  .pick__total dd {
    font-size: 56px;
    line-height: 0.85;
  }

  @keyframes pick-in {
    from {
      opacity: 0.001;
      transform: translateY(calc(var(--motion-distance) / 2));
    }
  }
</style>
